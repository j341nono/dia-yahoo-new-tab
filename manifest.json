{
  "manifest_version": 3,
  "name": "Yahoo New Tab for Dia",
  "version": "1.3",
  "description": "Open Yahoo! JAPAN with Dia-like bookmarks.",
  "permissions": [
    "tabs",
    "bookmarks",
    "favicon"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.yahoo.co.jp/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "_favicon/*"
      ],
      "matches": [
        "https://www.yahoo.co.jp/*"
      ]
    }
  ]
}
